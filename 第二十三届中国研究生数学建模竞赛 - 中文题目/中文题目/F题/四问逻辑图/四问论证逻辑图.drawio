<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" pages="1"><diagram id="四问论证逻辑图" name="四问论证技术路线"><mxGraphModel dx="2600" dy="2180" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2180" background="#101214" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="edge_034" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6bc9af;strokeWidth=3;dashed=0;dashPattern=7 6;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="617" as="sourcePoint" /><mxPoint x="60" y="729" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_062" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#e1ab69;strokeWidth=3;dashed=0;dashPattern=7 6;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1148" as="sourcePoint" /><mxPoint x="60" y="1257" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_084" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b4a0e6;strokeWidth=3;dashed=1;dashPattern=7 6;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1572" as="sourcePoint" /><mxPoint x="60" y="1681" as="targetPoint" /></mxGeometry></mxCell><mxCell id="box_001" value="" style="rounded=0;arcSize=0;html=1;fillColor=#62b5d4;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="31" y="26" width="5" height="102" as="geometry" /></mxCell><mxCell id="txt_002" value="四问论证技术路线" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=36;fontColor=#eceff2;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="86" y="27" width="1690" height="67" as="geometry" /></mxCell><mxCell id="txt_003" value="每行写明：证据从哪里来 → 经何种推理或验证 → 得到什么结论；过渡带写明跨问传递的量与假设。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#aab4bd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="88" y="98" width="2350" height="35" as="geometry" /></mxCell><mxCell id="box_004" value="" style="rounded=0;arcSize=0;html=1;fillColor=#62b5d4;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="37" y="160" width="5" height="462" as="geometry" /></mxCell><mxCell id="box_005" value="" style="rounded=1;arcSize=7;html=1;fillColor=#62b5d4;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="85" y="153" width="84" height="40" as="geometry" /></mxCell><mxCell id="txt_006" value="Q1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#101214;fontStyle=1;align=center;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="91" y="155" width="72" height="34" as="geometry" /></mxCell><mxCell id="txt_007" value="第一问｜从原始数据到质量评分、配比预测与可传递接口" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#e5e9ed;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="187" y="154" width="2190" height="40" as="geometry" /></mxCell><mxCell id="box_008" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="206" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_009" value="质量输入" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#62b5d4;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="207" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_010" value="A1 全量抽样＋A2/A3 扩展全集 → 22 项质量指标 → 方向统一与截尾归一化 → 线性评分 Q_lin" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="207" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_011" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="258" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_012" value="冲突消解" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#62b5d4;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="259" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_013" value="严格互斥的高/低尾部 → 指标对冲突与四维失衡 CI → 加权几何聚合 → 样本质量 Q_res" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="259" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_014" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="310" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_015" value="独立复核" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#62b5d4;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="311" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_016" value="A2/A3 中与 A1 ID 不重叠的余集 → 冻结尾部切点复核；去重聚合 → 7 个质量域 Q_d" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="311" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_017" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="362" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_018" value="质量映射" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#62b5d4;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="363" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_019" value="A16 的领域关系 → 7 个质量域映射到 17 个配方域 Q_i；无直接映射的 11 域作均值回退" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="363" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_020" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="414" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_021" value="配比模型" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#62b5d4;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="415" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_022" value="A4/A5：512 组配比 × 13 验证域 Loss → 对数线性／SCM → 训练侧稳定筛选 SCI → 均值预测" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="415" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_023" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="466" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_024" value="配比推荐" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#62b5d4;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="467" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_025" value="SCI 均值＋MPR-MTL 逐域残差 → CVaR 风险推荐 p_risk；凸包内双代理保守推荐 → p_safe" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="467" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_026" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="518" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_027" value="固定检验" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#62b5d4;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="519" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_028" value="A6–A11：1M／60M／1B 排序检验；A12–A15：10B／70B 幂律外推表，只作敏感性分析" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="519" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_029" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="570" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_030" value="关键判断" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#62b5d4;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="571" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_031" value="质量有效份额 p_eff∝p·Q_i^η 的内部验证选 η=0 → Q_i 与 p 分通道，不宣称 A 已识别质量效应" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="571" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_032" value="" style="rounded=1;arcSize=9;html=1;fillColor=#1c3137;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="634" width="2430" height="78" as="geometry" /></mxCell><mxCell id="txt_033" value="Q1 → Q2：第一问最终输出 Q_i＝Q_res 的域映射与 p_risk；旧版 Q1 输出对数混料系数及参考配比 p_ref。&lt;br&gt;模型角色：SCI 是 Q1 的均值预测器；Q2 为得到可解析的配比桥改用对数模型。p_safe 另由 Q1 直接进入 Q3。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#e5e9ed;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="112" y="643" width="2380" height="61" as="geometry" /></mxCell><mxCell id="box_035" value="" style="rounded=0;arcSize=0;html=1;fillColor=#6bc9af;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="37" y="742" width="5" height="407" as="geometry" /></mxCell><mxCell id="box_036" value="" style="rounded=1;arcSize=7;html=1;fillColor=#6bc9af;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="85" y="735" width="84" height="40" as="geometry" /></mxCell><mxCell id="txt_037" value="Q2" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#101214;fontStyle=1;align=center;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="91" y="737" width="72" height="34" as="geometry" /></mxCell><mxCell id="txt_038" value="第二问｜先识别规模与质量效应，再把第一问的 Q、p 接入广义标度律" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#e5e9ed;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="187" y="736" width="2190" height="40" as="geometry" /></mxCell><mxCell id="box_039" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="788" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_040" value="规模骨架" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#6bc9af;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="789" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_041" value="B1 轨迹 → 拟合经典 L＝E＋A·N^−α＋B·D^−β → 规模项 R(N,D)；B2–B5 检验迁移" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="789" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_042" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="840" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_043" value="质量效应" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#6bc9af;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="841" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_044" value="B6 比较质量项形式并估计 κ；B7 新质量水平作外层验证；B8 只作机制边界分析" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="841" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_045" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="892" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_046" value="Q 的衔接" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#6bc9af;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="893" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_047" value="Q1 的 Q_i 与配比 p → Q0_A(p)＝Σp_iQ_i；Q_A＝Q_res 经坐标桥映射到 B 的 Q_B" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="893" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_048" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="944" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_049" value="避免重计" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#6bc9af;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="945" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_050" value="以 Q0_A(p) 为当前配比的质量基线 → ψ_Q^rel(Q,p)＝ψ_Q^abs(Q)／ψ_Q^abs(Q0_A(p))" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="945" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_051" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="996" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_052" value="p 的衔接" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#6bc9af;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="997" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_053" value="Q1 对数混料 L_mix(p)／L_mix(p_ref) → ψ_p(p,N)；SCI 稳定交互只作辅助证据" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="997" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_054" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1048" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_055" value="识别边界" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#6bc9af;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1049" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_056" value="A6–A9 同配比跨规模排序可复核结构，但 γ_p 不可单独识别 → 名义 γ_p＝0＋情景敏感性" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1049" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_057" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1100" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_058" value="广义结论" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#6bc9af;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1101" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_059" value="L＝E＋R(N,D)·ψ_Q^rel(Q,p)·ψ_p(p,N) → 边际效用／替代条件；B9/B10 仅条件外推" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1101" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_060" value="" style="rounded=1;arcSize=9;html=1;fillColor=#352b22;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1166" width="2430" height="78" as="geometry" /></mxCell><mxCell id="txt_061" value="Q2 → Q3：传 L(N,D,Q,p)、质量基线 Q0_A(p)、κ、配比桥及 γ_p 未识别标记；不能把名义 γ_p 当实测。&lt;br&gt;Q3 同时从 Q1 读取可执行 p_risk／p_safe／p_measured；p_ref 只是第二问标度律的参考配比。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#e5e9ed;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="112" y="1175" width="2380" height="61" as="geometry" /></mxCell><mxCell id="box_063" value="" style="rounded=0;arcSize=0;html=1;fillColor=#e1ab69;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="37" y="1270" width="5" height="302" as="geometry" /></mxCell><mxCell id="box_064" value="" style="rounded=1;arcSize=7;html=1;fillColor=#e1ab69;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="85" y="1263" width="84" height="40" as="geometry" /></mxCell><mxCell id="txt_065" value="Q3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#101214;fontStyle=1;align=center;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="91" y="1265" width="72" height="34" as="geometry" /></mxCell><mxCell id="txt_066" value="第三问｜把广义损失变成预算内资源决策，而非再估计 Q 或配比规律" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#e5e9ed;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="187" y="1264" width="2190" height="40" as="geometry" /></mxCell><mxCell id="box_067" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1316" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_068" value="决策集合" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#e1ab69;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1317" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_069" value="Q1 配比候选＋Q2 广义损失 → p 取有限可执行集合；p_ref 仅比较基准，不参加最优解" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1317" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_070" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1368" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_071" value="成本约束" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#e1ab69;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1369" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_072" value="训练成本 6ND＋注意力开销＋质量治理成本；C7 定外生上下文 L_ctx 与注意力临界值" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1369" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_073" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1420" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_074" value="联合寻优" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#e1ab69;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1421" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_075" value="三档预算 10^19／10^22／10^24；三类质量成本 → 枚举配比与活跃约束，联合求 N、D、Q" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1421" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_076" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1472" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_077" value="结构转移" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#e1ab69;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1473" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_078" value="Q＝Q0 为 R0，内部质量治理为 R1，Q＝1 为 R2 → 连续预算扫描识别体制变化" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1473" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_079" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1524" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_080" value="结果边界" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#e1ab69;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1525" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_081" value="输出 (N*,D*,Q*,p*) 与 L*(C)，再作成本／上下文／情景稳健性；高预算标为远距离外推" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1525" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_082" value="" style="rounded=1;arcSize=9;html=1;fillColor=#2c2839;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1590" width="2430" height="78" as="geometry" /></mxCell><mxCell id="txt_083" value="Q3 → Q4：只传最优损失增量 ΔL*＝L*(C₀)−L*(C₁) 作条件性核对，不把绝对 Loss 当绝对能力分。&lt;br&gt;Q4 的能力前沿主证据仍来自 C 系列历史记录；Loss–Benchmark 转换须由 C5/C6 单独校准与验证。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#e5e9ed;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="112" y="1599" width="2380" height="61" as="geometry" /></mxCell><mxCell id="box_085" value="" style="rounded=0;arcSize=0;html=1;fillColor=#b4a0e6;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="37" y="1694" width="5" height="354" as="geometry" /></mxCell><mxCell id="box_086" value="" style="rounded=1;arcSize=7;html=1;fillColor=#b4a0e6;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="85" y="1687" width="84" height="40" as="geometry" /></mxCell><mxCell id="txt_087" value="Q4" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#101214;fontStyle=1;align=center;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="91" y="1689" width="72" height="34" as="geometry" /></mxCell><mxCell id="txt_088" value="第四问｜历史能力证据为主，第三问最优损失只提供一条旁证通道" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#e5e9ed;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="187" y="1688" width="2190" height="40" as="geometry" /></mxCell><mxCell id="box_089" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1740" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_090" value="能力定义" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#b4a0e6;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1741" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_091" value="C1 六维榜单 → 综合能力 S／模型类型／开源口径；C8 逐任务重建综合分并检验异质性" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1741" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_092" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1792" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_093" value="规模归因" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#b4a0e6;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1793" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_094" value="C1×C4 匹配训练算力 → Compute-Q90 前沿；按发布时间做算力／非规模时间漂移／残差分解" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1793" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_095" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1844" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_096" value="长期背景" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#b4a0e6;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1845" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_097" value="C3：2019–2025 时代视角；C4 变化点与训练算力增长率 → 延续／放缓／停滞情景" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1845" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_098" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1896" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_099" value="桥接验证" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#b4a0e6;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1897" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_100" value="C5 校准自适应 Loss–Benchmark Logistic 桥；C6 新增模型外层验证，再用 C6 全量重估" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1897" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_101" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="1948" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_102" value="增量核对" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#b4a0e6;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="1949" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_103" value="Q3 的 ΔL*＋当前实测前沿 F0 → 锚定的能力增量；大部分目标预算需远距离外推" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="1949" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_104" value="" style="rounded=1;arcSize=5;html=1;fillColor=#26292c;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="2000" width="2430" height="46" as="geometry" /></mxCell><mxCell id="txt_105" value="预测证据" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#b4a0e6;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="101" y="2001" width="169" height="44" as="geometry" /></mxCell><mxCell id="txt_106" value="有效滚动回测仅 3 个月，且无前沿刷新；与 Persistence 比较 → 12／24 月只报长期情景" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#d5d9dd;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="280" y="2001" width="2200" height="44" as="geometry" /></mxCell><mxCell id="box_107" value="" style="rounded=0;arcSize=0;html=1;fillColor=#4b5862;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="86" y="2076" width="2430" height="1" as="geometry" /></mxCell><mxCell id="txt_108" value="全链条：A 中质量与配比证据 → B 中 N、D、Q、p 的损失律 → C7 下的预算最优解 → C 历史前沿与条件预测。&lt;br&gt;证据边界：SCI 未成为 Q2 主配比桥；γ_p 未识别；Q3 最优是模型内结论；Q4 长期预测没有直接回测。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#aab4bd;fontStyle=0;align=left;verticalAlign=top;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="87" y="2091" width="2428" height="57" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>